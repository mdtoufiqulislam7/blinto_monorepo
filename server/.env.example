# Copy to server/.env (local dev) or set these in your hosting provider (production).
# Never commit the real .env file.

PORT=4000

# Postgres connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# In docker-compose the host is "postgres"; locally it is "localhost".
DATABASE_URL=postgres://postgres:change-me@localhost:5432/doomsday

# Redis connection string (cache + rate limiting)
REDIS_URL=redis://localhost:6379

# Comma-separated list of browser origins allowed by CORS (your client's public URL)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Number of reverse proxies in front of the API (nginx / load balancer / Next.js proxy = 1)
TRUST_PROXY=1

# Cache lifetime in seconds
CACHE_TTL_SECONDS=60

# Rate limiting (per IP, per window)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_READ_MAX=300
RATE_LIMIT_WRITE_MAX=40

# Load sample movies + cinemas into an empty database. Use false in production.
SEED=false
