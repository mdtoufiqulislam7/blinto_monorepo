# Copy to client/.env.local (local dev) or set in your hosting provider (production).
# Never commit the real env file.

# Where Next.js proxies /api/* to (your server's URL).
# docker-compose: http://server:4000   |   local dev: http://localhost:4000
# Read at build time, so set it before `npm run build` / `docker build`.
API_URL=http://localhost:4000
